APP_NAME="AI Learning Assistant"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- Database ---------------------------------------------------------
# The original project used MongoDB. This Laravel version uses a
# relational database (MySQL recommended). SQLite also works out of the box.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# --- Auth (replaces JWT) ----------------------------------------------
# Laravel Sanctum issues personal access tokens returned as `token`
# in the same shape the React app already expects.
SANCTUM_TOKEN_EXPIRATION=10080

# --- File storage -------------------------------------------------------
FILESYSTEM_DISK=public
MAX_FILE_SIZE=10485760

# --- Session / cache / queue --------------------------------------------
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync

# --- CORS ----------------------------------------------------------------
FRONTEND_URL=http://localhost:5173

# --- Gemini AI (same key as the original backend) ------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
